   "source": [
    "# Padé approximation (analytic continuation)\n",
    "\n",
    "Fit a Padé approximant and evaluate:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "1dd6def1",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "0.9125292418407961"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "using MatsubaraFunctions: PadeApprox\n",
    "\n",
    "x = collect(range(-1, 1; length=21))\n",
    "y = @. 1 / (1 + x^2) + 0.01randn()      # added small noise\n",
    "P = PadeApprox(x, y)\n",
    "P(0.3)"
   ]
  }
 ],
